# ---------------------------------------------------------------------------
# Sentinel AI - example environment file
#
# Copy to `.env` and edit the values you need.  Every setting is optional:
# the defaults below are the ones used when the file is absent.
# ---------------------------------------------------------------------------

# --- Identity --------------------------------------------------------------
APP_NAME=Sentinel AI
ENVIRONMENT=development

# CHANGE THIS before exposing the app to anyone.  It signs JWTs and derives
# the encryption key that protects face embeddings.
SECRET_KEY=sentinel-ai-change-this-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=720
PASSWORD_ITERATIONS=240000

# --- Network ---------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000

# --- Storage ---------------------------------------------------------------
# SQLite by default.  PostgreSQL works by using a SQLAlchemy URL, e.g.
# DATABASE_URL=postgresql+psycopg://sentinel:secret@localhost:5432/sentinel
DATABASE_URL=sqlite:///./storage/sentinel.db
STORAGE_DIR=./storage
FRONTEND_DIST=./frontend/dist
SEED_DEMO_DATA=true
# Set to true for one start to wipe and re-seed the database.
RESET_DATABASE=false

# --- Direct live camera (recommended) -------------------------------------
# LIVE_ONLY streams the physical camera directly to the dashboard. No demo
# frames or seeded incidents are produced in this mode.  Evidence is separate:
# EVIDENCE_ENABLED=true saves event snapshots and clips from the real camera.
LIVE_ONLY=true
EVIDENCE_ENABLED=true
LIVE_CAMERA_INDEX=0
LIVE_CAMERA_NAME=Live Security Camera
LIVE_CAMERA_FPS=15
CAMERA_DISCOVERY_MAX_INDEX=5
# auto = try DirectShow before MSMF on Windows (MSMF often opens a webcam but
# returns no frames).  dshow / msmf force one backend.
WEBCAM_BACKEND=auto
WEBCAM_SWITCH_SECONDS=6

# --- AI pipeline -----------------------------------------------------------
PIPELINE_ENABLED=true
# auto   -> try YOLO, fall back to the OpenCV motion detector
# yolo   -> require Ultralytics YOLO
# demo   -> synthetic scenes and detections (no camera or model needed)
DETECTOR_MODE=auto
DEMO_MODE=false
DEMO_AUTOTRIGGER=false
TARGET_FPS=8
FRAME_WIDTH=960
FRAME_HEIGHT=540
YOLO_MODEL=yolov8n.pt
YOLO_CONFIDENCE=0.35
FACE_RECOGNITION_ENABLED=false
FACE_MATCH_THRESHOLD=0.42

# --- Evidence --------------------------------------------------------------
# Event-based evidence: a JPEG snapshot and a short MP4 clip are written to
# storage/snapshots and storage/clips when a real incident is detected.
RECORDING_ENABLED=true
PRE_EVENT_SECONDS=6
POST_EVENT_SECONDS=3
# Continuous recording writes non-stop video segments to
# storage/clips/continuous, so nothing between alarms is lost.
CONTINUOUS_RECORDING_ENABLED=true
CONTINUOUS_SEGMENT_SECONDS=300
# Save a JPEG for every verified motion/person/vehicle event as well.
SAVE_MOTION_SNAPSHOTS=true
RETENTION_DAYS=14

# --- Alarm response --------------------------------------------------------
VOICE_ENABLED=true
VOICE_REPEAT_SECONDS=20
SIREN_ENABLED=false
# Optional JSON webhook for every incident (Slack/Teams/custom collector).
WEBHOOK_URL=
